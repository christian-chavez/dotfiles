# set selection-clipboard none
set selection-clipboard clipboard
set guioptions s

# set guioptions ""
set statusbar-basename  "true"
set statusbar-home-tilde "true"
set window-title-home-tilde "true"
map w adjust_window width
map S adjust_window width
map i toggle_inputbar
set synctex "true"
# set synctex-editor-command "code --no-sandbox -r -g %{input}:%{line}"
set synctex-editor-command "nvim --headless -c \"VimtexInverseSearch %{line}:%{column} '%{input}'\""
# set adjust-open width 
set adjust-open best-fit
set first-page-column "1:1"

# d: toggle dual-page view and fit width in one keystroke
map <A-d> toggle_page_mode
map d feedkeys "<A-d>s"
# set font "Iosevka 10"
set font "Iosevka Medium 11"

# colours follow nvim's tokyonight-night (tokyonight.nvim colors/night.lua):
# bg #1a1b26 around the pages, bg_dark #16161e for bars and popups. The dark
# surround is what makes the white page edges easy to tell apart.
# (was: default-bg #f2f2f2, statusbar #3b4252 on #d8dee9)
# set statusbar-fg                "#3b4252"
# set statusbar-bg                "#d8dee9"
# set default-bg "#f2f2f2"
# 85% opaque: picom blurs the wallpaper behind the surround (pages stay solid);
# 1.0 or "#1a1b26" for fully opaque
set default-bg                  "rgba(26,27,38,0.85)"
set default-fg                  "#c0caf5"
set statusbar-bg                "#16161e"
set statusbar-fg                "#a9b1d6"
set inputbar-bg                 "#16161e"
set inputbar-fg                 "#c0caf5"
set notification-bg             "#16161e"
set notification-fg             "#c0caf5"
set notification-warning-bg     "#16161e"
set notification-warning-fg     "#e0af68"
set notification-error-bg       "#16161e"
set notification-error-fg       "#f7768e"
set completion-bg               "#16161e"
set completion-fg               "#c0caf5"
set completion-group-bg         "#16161e"
set completion-group-fg         "#7aa2f7"
set completion-highlight-bg     "#414868"
set completion-highlight-fg     "#c0caf5"
set index-bg                    "#1a1b26"
set index-fg                    "#c0caf5"
set index-active-bg             "#414868"
set index-active-fg             "#c0caf5"
# selected text + search matches: your original blue; current match: green
set highlight-color             rgba(136,192,208,0.5)
set highlight-active-color      rgba(158,206,106,0.5)
# set statusbar-fg                "#D8DEE9"
# set statusbar-bg                "#2E3440"
set scroll-step 45
set scroll-page-aware true
# set smooth-scroll "true"
# set highlight-fg rgba(136,192,208,0.5)
set statusbar-h-padding 8
set statusbar-v-padding 0
# gap between pages (and between columns in dual-page view)
set page-v-padding 10
set page-h-padding 10
set page-cache-size 20
set selection-notification false
# set highlight-active-color "rgba(10,188,0,0.0)"

# # para cambiar colores del programa
# set recolor true
# set default-bg "#C7EDCC"
# dark mode (Ctrl+R): pages get tokyonight-storm's bg, a shade lighter than
# the #1a1b26 surround so they stay distinguishable (was nord #2e3440)
set recolor-lightcolor "#24283b"
set recolor-darkcolor "#c0caf5"
set recolor-keephue true
set recolor-reverse-video true
# set recolor-ssdarkcolor "#e3e2e1"
# # set recolor-darkcolor "#000000"

# abrir parent folder
# map <C-t> exec sh -c 'xdg-open "$(dirname "$FILE")"'
# map q abort
# map <C-1> set first-page-column 1

# map . feedkeys ":exec dragon-drop -x -i -T \"$FILE\"<Return>"
map . exec "env GDK_SCALE=2 dragon-drop -x -i -T '$FILE'"

# Copy the PDF path to the clipboard
map [normal] xp exec "sh -c 'printf %s \"$1\" | xclip -selection clipboard' sh '$FILE'"

# Open the PDF's directory in Yazi
# map [normal] xy exec "sh -c 'cd -- \"$(dirname -- \"$1\")\" && exec alacritty -e yazi' sh '$FILE'"
map [normal] xy exec "alacritty -e yazi '$FILE'"

# Show pdfinfo in Alacritty
map [normal] xi exec "alacritty --hold -e /home/christian/.local/bin/zathura-pdfinfo '$FILE'"

# extract pages
map [normal] xr exec "/home/christian/.local/bin/zathura-pages '$FILE' '$PAGE'"

# rename file
map [normal] xw exec "/home/christian/.local/bin/zathura-rename '$FILE' '$PAGE' '$DBUS'"
