{
	"Function": {
		"prefix": "fun",
		"body": "f:$1\\R\\to\\R$0"
	},
	"reference": {
		"prefix": "ref",
		"body": "\\ref{${1:${TM_SELECTED_TEXT}}}$0"
	},
	"Mathfrak": {
		"prefix": "mf",
		"body": "\\mathfrak{$1}$0"
	},
	"Display math": {
		"prefix": "dd",
		"body": "\\[\n$0\n\\]"
	},
	"Partial": {
		"prefix": "pp",
		"body": "\\partial$0"
	},
	"subset": {
		"prefix": "ss",
		"body": "\\subseteq$0"
	},
	"Inline math": {
		"prefix": "mm",
		"body": "\\($0\\)"
	},
	"Dollar Inline math": {
		"prefix": "ii",
		"body": "\\$$1 \\$ $0"
	},
	"Subset": {
		"prefix": "cc",
		"body": "\\subset$1eq$0"
	},
	"Sine": {
		"prefix": "sin",
		"body": "\\sin$0"
	},
	"Cosine": {
		"prefix": "cos",
		"body": "\\cos$0"
	},
	"Tangent": {
		"prefix": "tan",
		"body": "\\tan$0"
	},
	"Cotangent": {
		"prefix": "cot",
		"body": "\\cot$0"
	},
	"Exponetial": {
		"prefix": "exp",
		"body": "\\exp$0"
	},
	"Logarithm": {
		"prefix": "log",
		"body": "\\log$0"
	},
	"Absolute value": {
		"prefix": "abs",
		"body": "\\abs{$1}$0"
	},
	"Implies": {
		"prefix": "implies",
		"body": "\\implies$0"
	},
	"If and only if": {
		"prefix": "iff",
		"body": "\\iff$0"
	},
	"Belongs": {
		"prefix": "in",
		"body": "\\in$0"
	},
	"set": {
		"prefix": "set",
		"body": "\\left\\{ $1 : $2 \\right\\\\}$0"
	},
	"Integral": {
		"prefix": "integral",
		"body": [
			"\\int_{${1:a}}^{${2:b}}$3\\dd x $0"
		]
	},
	"and in between math display mode": {
		"prefix": "qnn",
		"body": "\\quad\\text{and}\\quad$0"
	},
	"Derivada": {
		"prefix": "derivative",
		"body": "\\frac{\\dd $1}{\\dd $2}$0"
	},
	"Greater or equal than": {
		"prefix": ">>",
		"body": "\\geq $0"
	},
	"Augmented Matrix": {
		"prefix": "amm",
		"body": [
			"\\Amatrix{",
			"\t$0;",
			"}"
		]
	},
	"Augmented n Matrix": {
		"prefix": "amn",
		"body": [
			"\\AAmatrix{",
			"\t$0;",
			"}"
		]
	},
	"Determinant matrix": {
		"prefix": "dmm",
		"body": [
			"\\Dmatrix{",
			"\t$0;",
			"}"
		]
	},
	"Math caligraphic": {
		"prefix": "mcal",
		"body": "\\mathcal{$1}$0"
	},
	"Math slanted": {
		"prefix": "msl",
		"body": "\\mathsl{$1}$0"
	},
	"Generador": {
		"prefix": "gen",
		"body": "\\gen $0"
	},
	"Align*": {
		"prefix": "al",
		"body": [
			"\\begin{align*}",
			"$0",
			"\\end{align*}"
		]
	},
	"itemize": {
		"prefix": "itemize",
		"body": [
			"\\begin{itemize}",
			"\\item $1",
			"\\end{itemize}",
			"$0"
		]
	},
	"enumerate": {
		"prefix": "enum",
		"body": [
			"\\begin{enumerate}[label=(\\roman$1*)]",
			"\\item $0",
			"\\end{enumerate}"
		]
	},
	"enumerate-roman": {
		"prefix": "enu",
		"body": [
			"\\begin{enumerate}",
			"\\item $0",
			"\\end{enumerate}"
		]
	},
	"Theorem": {
		"prefix": "thm",
		"body": [
			"\\begin{theorem}",
			"$0",
			"\\end{theorem}"
		]
	},
	"Proof": {
		"prefix": "proof",
		"body": [
			"\\begin{proof}",
			"$0",
			"\\end{proof}"
		]
	},
	"Problem": {
		"prefix": "problem",
		"body": [
			"\\begin{problem}",
			"$0",
			"\\end{problem}"
		]
	},
	"Proposition": {
		"prefix": "proposition",
		"body": [
			"\\begin{proposition}",
			"$0",
			"\\end{proposition}"
		]
	},
	"Definition": {
		"prefix": "definition",
		"body": [
			"\\begin{definition}",
			"$0",
			"\\end{definition}"
		]
	},
	"Remark": {
		"prefix": "remark",
		"body": [
			"\\begin{remark}",
			"$0",
			"\\end{remark}"
		]
	},
	"Example": {
		"prefix": "example",
		"body": [
			"\\begin{example}",
			"$0",
			"\\end{example}"
		]
	},
	"Problema": {
		"prefix": "problema",
		"body": [
			"\\begin{problema}",
			"$0",
			"\\end{problema}"
		]
	},
	"Frame": {
		"prefix": "frame",
		"body": [
			"\\begin{frame}{$1}",
			"$0",
			"\\end{frame}"
		]
	},
	"Environment": {
		"prefix": "beg",
		"body": [
			"\\begin{${1:name}}",
			"$0",
			"\\end{${1:name}}"
		]
	},
	"Image": {
		"prefix": "img",
		"body": [
			"\\begin{figure}[!htb]",
			"\t\\centering",
			"\t\\includegraphics[width=0.5$1\\textwidth]{$2}",
			"\t\\caption{$3}%\\label{fig:$3}",
			"\\end{figure}",
			"$0"
		]
	},
	"pmatrix": {
		"prefix": "pm",
		"body": [
			"\\begin{pmatrix}",
			"$1",
			"\\end{pmatrix}",
			"$0"
		]
	},
	"Sum": {
		"prefix": "sum",
		"body": [
			"\\sum_{${1:i=0}}^{${2:\\infty}} $0"
		]
	},
	"Big_Cup": {
		"prefix": "bcup",
		"body": [
			"\\bigcup_{i\\in I}$0"
		]
	},
	"Big_Cap": {
		"prefix": "bcap",
		"body": [
			"\\bigcap_{i\\in I}$0"
		]
	},
	"Family of sets": {
		"prefix": "fam",
		"body": [
			"\\(\\left( F_\\alpha \\right)_{\\alpha\\in I}\\)$0"
		]
	},
	"Topological space": {
		"prefix": "tops",
		"body": [
			"\\(\\left( X, \\mathscr{T} \\right)\\)$0"
		]
	},
	"Metric space": {
		"prefix": "met",
		"body": [
			"\\(\\left( X, d \\right)\\)$0"
		]
	},
	"Net": {
		"prefix": "net",
		"body": "\\(\\left( x_\\alpha \\right)_{\\alpha\\in D}\\)"
	},
	"Sequence": {
		"prefix": "seq",
		"body": "\\(\\left( x_n \\right)_{n=1}^\\infty\\)"
	},
	"Epsilon": {
		"prefix": "epsilon",
		"body": "\\( \\varepsilon > 0 \\)"
	},
	"Union": {
		"prefix": "bunion",
		"body": "\\bcup_{\\alpha\\in I} O_\\alpha"
	},
	"For the sake of contradiction": {
		"prefix": "fsc",
		"body": "for the sake of contradiction"
	},
	"Autoref command": {
		"prefix": "aref",
		"body": "\\autoref{$1}$0"
	}
}
