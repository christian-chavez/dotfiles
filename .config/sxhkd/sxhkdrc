#
# sxhkd - bspwm keybindings
#
# reload after editing:  super + Escape
# all referenced scripts live in ~/.local/bin
#

# ============================================================ sxhkd / bspwm
# reload sxhkd
super + Escape
	pkill -USR1 -x sxhkd

# quit / restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close / kill window
super + {_,shift + }w
	bspc node -{c,k}

# ==================================================================== layout
# toggle tiled / monocle on the desktop
super + m
	bspc desktop -l next

# window state: tiled / pseudo-tiled / floating
super + {t,shift + t,s}
	bspc node -t {tiled,pseudo_tiled,floating}

# toggle fullscreen
super + f
	bspc node -t '~fullscreen'

# node flags: marked / locked / sticky / private
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

# swap current with the biggest window
super + g
	bspc node -s biggest.window

# swap current with the last window, follow focus
super + x
	bspc node -s last.local; \
	bspc node -f last.local

# rotate the parent split 90 degrees
super + shift + e
	bspc node '@parent' -R 90

# balance: reset every split ratio on the desktop so windows share space evenly
super + shift + b
	bspc node @/ -B

# ===================================================================== focus
# focus / swap in a direction
# (east removed - plain "super + l" collided with "super + @l" = suspend)
super + {_,shift + }{h,j,k}
	bspc node -{f,s} {west,south,north}

# focus the first / second child of the parent
# (parent/brother removed - "super + p/b" collided with "super + @p / @b")
super + {comma,period}
	bspc node -f @{first,second}

# focus next / previous window on the desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# focus previous / next desktop on this monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last desktop
# (the "grave" half was dropped: on the latam layout that key is dead_grave,
#  so sxhkd could never bind it. Rebind "focus last node" elsewhere if wanted:
#  super + shift + Tab  ->  bspc node -f last.local)
super + Tab
	bspc desktop -f last

# focus older / newer in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# focus / send to desktop 1-10
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}' --follow

# ================================================================= preselect
# preselect a direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the split ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel preselection on the focused node
super + ctrl + space
	bspc node -p cancel

# cancel preselection on every node of the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

# =============================================================== move / resize
# expand a window (push a side outward)
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window (pull a side inward)
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# ==================================================================== displays
# monitor layout menu (autorandr profiles + auto-detect + mirror)
super + alt + p
	$HOME/.local/bin/display-menu

# session/system toggles menu (picom, syncthing, ...)
super + alt + t
	$HOME/.local/bin/rofi-toggles

# ================================================================== launchers
# terminal
super + Return
	alacritty

# app launcher / power menu
super + @space
	rofi -no-lazy-grab -show combi -combi-modi drun,menu:rofi-power-menu -normal-window

# browser
super + @b
	firefox

# file manager (yazi)
super + e
	alacritty --class yazi-fm,Alacritty -e bash -ic 'cd "$HOME" && exec yazi .'

# clipboard history (greenclip)
super + a
	rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}' -normal-window

# google search
super + d
	$HOME/.local/bin/rofi-google.sh

# file search (rofi)
super + shift + a
	$HOME/.local/bin/rofi-files.sh

# file search - google drive
super + shift + @space
	$HOME/.local/bin/rofi-files-google-drive.sh

# recent pdfs (full history)
super + shift + @p
	$HOME/.local/bin/zathura-recent-files-rofi list

# obsidian
super + shift + o
	$HOME/Documents/Obsidian-1.9.14.AppImage --no-sandbox

# mathpix
super + shift + m
	$HOME/Documents/Mathpix.AppImage

# xournalpp - lined letter template
super + n
	xournalpp "$HOME/Templates/lined-letter-template.pdf"

# typed info snippets  (chain: super + u, then a letter)
super + u ; {i,c,m,e,f,F,n,s,u,U,M,k,d,j,p,a,t,l,x}
	$HOME/.local/bin/type_info.sh {i,c,m,e,f,F,n,s,u,U,M,k,d,j,p,a,t,l,x}

# ================================================================ scratchpads
# scratch nvim
super + @p
	bspc rule -a ScratchNvim -o state=floating rectangle=570x225+760+500; alacritty --class ScratchNvim,ScratchNvim -e nvim

# scratch calc
super + y
	bspc rule -a ScratchCalc -o state=floating rectangle=360x225+970+500; alacritty --class ScratchCalc,ScratchCalc -o font.size=14 -e calc -d

# ================================================================ window mgmt
# hide the focused window
super + shift + i
	$HOME/.local/bin/winhide

# ===================================================================== media
XF86AudioRaiseVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1

XF86AudioLowerVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-

XF86AudioMute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioPlay
	playerctl play-pause

XF86AudioNext
	playerctl next

XF86AudioPrev
	playerctl previous

# ================================================================ brightness
XF86MonBrightnessDown
	brillo -u 100000 -U 5

XF86MonBrightnessUp
	brillo -u 100000 -A 5

# max / min brightness
super + alt + m
	brillo -u 150000 -S 100

super + alt + n
	brillo -u 150000 -S 0

# =============================================================== screenshots
# region select -> edit
Print
	$HOME/.local/bin/flameshot-focus.sh

# region select -> save immediately
shift + Print
	flameshot gui -p $HOME/Pictures/Screenshots

# full screen -> save immediately
super + Print
	flameshot full --region all -p $HOME/Pictures/Screenshots

# =================================================================== session
# redshift warm
super + shift + r
	redshift -O 4000

# wacom tablet (external / laptop)
super + shift + x
	$HOME/.local/bin/xsetwacom-new.sh

super + shift + alt + x
	$HOME/.local/bin/xsetwacom-new-laptop.sh

# suspend (on key release)
super + @l
	systemctl suspend-then-hibernate

# lock via display manager, then suspend (on key release)
super + shift + @l
	dm-tool lock && systemctl suspend
