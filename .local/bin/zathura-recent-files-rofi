#!/bin/bash

BOOKMARKS="$HOME/.config/zathura/filemarks"
LOCKFILE="$BOOKMARKS.lock"

mkdir -p "$(dirname "$BOOKMARKS")"

update_history() {
    local REAL="$1"

    # Solo PDFs
    [[ "${REAL,,}" == *.pdf ]] || return

    # Asegurar que exista el archivo
    touch "$BOOKMARKS"

    # Temp único por proceso
    local TMP
    TMP=$(mktemp)

    # Seccion critica: solo aqui usamos flock
    {
        flock -x 9

        # Quitar duplicados del mismo archivo
        rg -N --no-heading -Fxv "$REAL" "$BOOKMARKS" 2>/dev/null > "$TMP"
        echo "$REAL" >> "$TMP"

        # Limitar historial
        tail -n 1000 "$TMP" > "$BOOKMARKS"
    } 9>"$LOCKFILE"

    rm -f "$TMP"
}

clean_history() {
    local TMP
    TMP=$(mktemp)

    touch "$BOOKMARKS"

    {
        flock -x 9

        while IFS= read -r FILE; do
            [ -f "$FILE" ] && printf '%s\n' "$FILE"
        done < "$BOOKMARKS" > "$TMP"

        mv "$TMP" "$BOOKMARKS"
    } 9>"$LOCKFILE"

    rm -f "$TMP"
}

list_history() {
    local CHOICE FILE

    CHOICE=$(
        tac "$BOOKMARKS" 2>/dev/null \
        | awk -F/ '{print $NF}' \
        | rofi -normal-window -dmenu -i -p "PDFs:"
    )

    if [ -n "$CHOICE" ]; then
        FILE=$(awk -F/ -v b="$CHOICE" '$NF == b {print}' "$BOOKMARKS" | tail -n 1)
        [ -n "$FILE" ] && zathura-recent-files-rofi "$FILE"
    fi
}

case "$1" in
    list)
        # clean_history
        list_history
        ;;

    clean)
        clean_history
        ;;

    *)
        for FILE in "$@"; do
            REAL=$(realpath "$FILE" 2>/dev/null) || continue
            update_history "$REAL"
        done

        exec zathura "$@"
        ;;
esac
