#!/bin/sh
# =============================================================================
# wallpaper -- pick / restore the desktop wallpaper
# =============================================================================
#   wallpaper            rofi thumbnail menu of $DIR; apply the choice with feh
#                        and remember it (absolute path) in ~/.cache/wallpaper
#   wallpaper --restore  re-apply the remembered wallpaper -- called from
#                        bspwmrc so the choice survives a login / `bspc wm -r`
#
# Override the image directory with $WALLPAPER_DIR.
# =============================================================================
set -eu

DIR="${WALLPAPER_DIR:-$HOME/Pictures/wallpapers}"
STATE="$HOME/.cache/wallpaper"
DEFAULT="$DIR/fuji.png"

set_bg() { feh --no-fehbg --bg-fill "$1"; }

list_images() {
    find "$DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
        2>/dev/null | sort
}

if [ "${1:-}" = --restore ]; then
    f=$(cat "$STATE" 2>/dev/null || true)
    if [ -z "$f" ] || [ ! -f "$f" ]; then
        if [ -f "$DEFAULT" ]; then f="$DEFAULT"; else f=$(list_images | head -n1); fi
    fi
    [ -n "${f:-}" ] && set_bg "$f"
    exit 0
fi

[ -d "$DIR" ] || {
    command -v notify-send >/dev/null 2>&1 && notify-send "wallpaper" "missing: $DIR"
    exit 1
}

choice=$(
    list_images | while IFS= read -r p; do
        printf '%s\0icon\037%s\n' "${p##*/}" "$p"
    done | rofi -dmenu -i -p "wallpaper" -show-icons
) || exit 0
[ -n "$choice" ] || exit 0

set_bg "$DIR/$choice"
mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$DIR/$choice" > "$STATE"
