#!/usr/bin/env python3
# clipboard-keeper: keep the clipboard pasteable after the app that owns it
# closes.
#
# On X11 the clipboard lives inside the app you copied from: close that app
# and there is nothing left to paste. greenclip records every copy but never
# takes over, so the text shows up in its history (super + a) while pasting
# does nothing. This waits (via XFixes, no polling) for the clipboard owner's
# window or X connection to go away and, if that left the clipboard without
# an owner, re-offers greenclip's newest entry -- exactly what picking it in
# rofi does. A deliberate clear (e.g. a password manager emptying the
# clipboard) drops ownership without the owner going away, so it is left
# alone.
#
# It also keeps the image history: greenclip's own image support burns ~25%
# CPU while an image sits in the clipboard, so it is off. Each copied image is
# saved once to IMAGE_DIR instead (newest by mtime, deduplicated by content,
# capped at IMAGE_KEEP); rofi-clip-images (super + alt + a) pastes them back.
#
# Started from bspwmrc; errors go to ~/.cache/clipboard-keeper.log

import ctypes
import ctypes.util
import hashlib
import os
import subprocess
import sys
import time
import tomllib
from pathlib import Path

GREENCLIP_CONFIG = Path.home() / ".config/greenclip.toml"
IMAGE_DIR = Path.home() / ".cache/clipboard-images"
IMAGE_KEEP = 60

# XFixes selection event masks, from <X11/extensions/Xfixes.h>
SELECTION_SET_OWNER = 1 << 0
SELECTION_WINDOW_DESTROY = 1 << 1
SELECTION_CLIENT_CLOSE = 1 << 2
# XFixesSelectionNotifyEvent.subtype for a new owner (or a deliberate clear)
SET_SELECTION_OWNER_NOTIFY = 0

x11 = ctypes.CDLL(ctypes.util.find_library("X11"))
xfixes = ctypes.CDLL(ctypes.util.find_library("Xfixes"))
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XInternAtom.restype = ctypes.c_ulong
x11.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
x11.XGetSelectionOwner.restype = ctypes.c_ulong
x11.XGetSelectionOwner.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
x11.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
xfixes.XFixesQueryExtension.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_int)]
xfixes.XFixesSelectSelectionInput.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong, ctypes.c_ulong]


def newest_entry():
    """greenclip's newest history entry, as `greenclip print` lists it."""
    out = subprocess.run(["greenclip", "print"], capture_output=True, text=True, errors="surrogateescape").stdout
    lines = out.split("\n")[:-1]  # one entry per line, newlines shown as U+00A0
    # the list is history followed by static_history: with an empty history
    # the first line is a static entry, which must not be pasted on its own
    try:
        static = tomllib.loads(GREENCLIP_CONFIG.read_text())["greenclip"].get("static_history", [])
    except (OSError, KeyError, tomllib.TOMLDecodeError):
        static = []
    return lines[0] if len(lines) > len(static) else None


def restore(dpy, clipboard):
    entry = newest_entry()
    if entry is None:
        return
    try:
        subprocess.run(["greenclip", "print", entry])
    except OSError as e:  # e.g. an entry too long to pass as an argument
        print(f"clipboard-keeper: greenclip print failed: {e}", file=sys.stderr)
        return
    # greenclip forks a child that takes ownership; wait for it so the other
    # notification for the same loss (window destroy + client close) is a no-op
    deadline = time.monotonic() + 2
    while not x11.XGetSelectionOwner(dpy, clipboard) and time.monotonic() < deadline:
        time.sleep(0.05)


def save_image():
    """Store the clipboard's PNG, if it offers one, in IMAGE_DIR; return its path."""
    xclip = ["xclip", "-selection", "clipboard", "-o", "-t"]
    targets = subprocess.run(xclip + ["TARGETS"], capture_output=True, text=True, timeout=5).stdout
    if "image/png" not in targets.split():
        return None
    png = subprocess.run(xclip + ["image/png"], capture_output=True, timeout=10).stdout
    if not png:
        return None
    IMAGE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = IMAGE_DIR / f"{hashlib.sha1(png).hexdigest()[:16]}.png"
    if path.exists():
        os.utime(path)  # copied again: move it to the top
    else:
        path.write_bytes(png)
    for old in sorted(IMAGE_DIR.glob("*.png"), key=lambda f: f.stat().st_mtime)[:-IMAGE_KEEP]:
        old.unlink()
    return path


def offer_image(dpy, clipboard, path):
    # xclip reads the file, then forks a child that owns the clipboard
    subprocess.run(["xclip", "-selection", "clipboard", "-t", "image/png", "-i", str(path)], timeout=10)
    deadline = time.monotonic() + 2
    while not x11.XGetSelectionOwner(dpy, clipboard) and time.monotonic() < deadline:
        time.sleep(0.05)


def main():
    dpy = x11.XOpenDisplay(None)
    if not dpy:
        sys.exit("clipboard-keeper: cannot open display")
    event_base, error_base = ctypes.c_int(), ctypes.c_int()
    if not xfixes.XFixesQueryExtension(dpy, ctypes.byref(event_base), ctypes.byref(error_base)):
        sys.exit("clipboard-keeper: XFixes extension not available")
    clipboard = x11.XInternAtom(dpy, b"CLIPBOARD", False)
    xfixes.XFixesSelectSelectionInput(dpy, x11.XDefaultRootWindow(dpy), clipboard,
                                      SELECTION_SET_OWNER | SELECTION_WINDOW_DESTROY | SELECTION_CLIENT_CLOSE)

    event = (ctypes.c_long * 24)()  # sizeof(XEvent)
    last_image = None  # the clipboard's current content, if it is an image
    while True:
        x11.XNextEvent(dpy, event)
        is_selection_notify = ctypes.c_int.from_buffer(event).value == event_base.value
        if not is_selection_notify:
            continue
        # subtype follows type, serial, send_event, display and window
        subtype = ctypes.c_int.from_buffer(event, 5 * ctypes.sizeof(ctypes.c_long)).value
        owner = x11.XGetSelectionOwner(dpy, clipboard)
        if subtype == SET_SELECTION_OWNER_NOTIFY:
            last_image = None  # a new copy, or a deliberate clear: left empty
            if owner:
                try:
                    last_image = save_image()
                except (OSError, subprocess.TimeoutExpired) as e:
                    print(f"clipboard-keeper: saving image failed: {e}", file=sys.stderr)
        elif not owner:  # the owner's window or connection went away
            # greenclip only has text, so an image is put back from its file
            if last_image and last_image.exists():
                offer_image(dpy, clipboard, last_image)
            else:
                restore(dpy, clipboard)


if __name__ == "__main__":
    main()
