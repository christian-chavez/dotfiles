#!/bin/sh

# Send repeated low-battery notifications with escalating urgency,
# and a one-shot notification when the battery is charged.

export DISPLAY=:0
export DBUS_SESSION_BUS_ADDRESS='unix:path=/run/user/1000/bus'

# Thresholds
# <= 15%  -> every 120s
# <  12%  -> every 60s
# <   9%  -> every 30s
# <   7%  -> every 7s
WARNING_LEVEL=15
MEDIUM_LEVEL=12
HIGH_LEVEL=9
CRITICAL_LEVEL=7

# Repeat intervals, in seconds
WARNING_INTERVAL=120
MEDIUM_INTERVAL=60
HIGH_INTERVAL=30
CRITICAL_INTERVAL=10

# State files
LOW_BATTERY_LAST=/tmp/battery-low-last
LOW_BATTERY_TIER=/tmp/battery-low-tier
FULL_FILE=/tmp/batteryfull

# Collect internal batteries from /sys/class/power_supply
BAT_DIRS=
for d in /sys/class/power_supply/*; do
  [ -d "$d" ] || continue
  [ -f "$d/type" ] || continue

  if grep -qx 'Battery' "$d/type"; then
    # Skip peripherals
    if [ -f "$d/scope" ] && grep -qx 'Device' "$d/scope"; then
      continue
    fi
    BAT_DIRS="$BAT_DIRS $d"
  fi
done

# If nothing matched, bail out quietly
[ -n "$BAT_DIRS" ] || exit 0

# Aggregate percentage across internal batteries.
# Prefer energy_now/energy_full if available; otherwise fall back to capacity (%).
total_now=0
total_full=0
level_fallbacks=
BATTERY_DISCHARGING=0

for d in $BAT_DIRS; do
  # Track discharging if any pack is discharging
  if [ -f "$d/status" ] && grep -qi 'discharging' "$d/status"; then
    BATTERY_DISCHARGING=1
  fi

  if [ -f "$d/energy_now" ] && [ -f "$d/energy_full" ]; then
    now=$(cat "$d/energy_now" 2>/dev/null || echo 0)
    full=$(cat "$d/energy_full" 2>/dev/null || echo 0)
  elif [ -f "$d/charge_now" ] && [ -f "$d/charge_full" ]; then
    now=$(cat "$d/charge_now" 2>/dev/null || echo 0)
    full=$(cat "$d/charge_full" 2>/dev/null || echo 0)
  else
    now=
    full=
  fi

  if [ -n "$now" ] && [ -n "$full" ] && [ "$full" -gt 0 ] 2>/dev/null; then
    total_now=$((total_now + now))
    total_full=$((total_full + full))
  elif [ -f "$d/capacity" ]; then
    cap=$(cat "$d/capacity" 2>/dev/null || echo 0)
    level_fallbacks="$level_fallbacks $cap"
  fi
done

if [ "$total_full" -gt 0 ] 2>/dev/null; then
  BATTERY_LEVEL=$(( (100 * total_now) / total_full ))
else
  min=101
  for cap in $level_fallbacks; do
    [ "$cap" -lt "$min" ] 2>/dev/null && min=$cap
  done
  [ "$min" -le 100 ] 2>/dev/null || exit 0
  BATTERY_LEVEL=$min
fi

# Reset state when charging again
if [ "$BATTERY_DISCHARGING" -eq 1 ] && [ -f "$FULL_FILE" ]; then
  rm -f "$FULL_FILE"
elif [ "$BATTERY_DISCHARGING" -eq 0 ]; then
  rm -f "$LOW_BATTERY_LAST" "$LOW_BATTERY_TIER"
fi

# Fully charged: notify once
if [ "$BATTERY_LEVEL" -gt 90 ] && [ "$BATTERY_DISCHARGING" -eq 0 ] && [ ! -f "$FULL_FILE" ]; then
  notify-send 'Battery Charged' 'Battery is fully charged.' -i 'battery' -r 9991
  touch "$FULL_FILE"

# Low battery: repeated alerts with escalation
elif [ "$BATTERY_DISCHARGING" -eq 1 ] && [ "$BATTERY_LEVEL" -le "$WARNING_LEVEL" ]; then
  now=$(date +%s)

  tier=1
  interval=$WARNING_INTERVAL
  body="${BATTERY_LEVEL}% of battery remaining."

  if [ "$BATTERY_LEVEL" -lt "$CRITICAL_LEVEL" ]; then
    tier=4
    interval=$CRITICAL_INTERVAL
    body="${BATTERY_LEVEL}% of battery remaining. Plug in now."
  elif [ "$BATTERY_LEVEL" -lt "$HIGH_LEVEL" ]; then
    tier=3
    interval=$HIGH_INTERVAL
    body="${BATTERY_LEVEL}% of battery remaining. Plug in now."
  elif [ "$BATTERY_LEVEL" -lt "$MEDIUM_LEVEL" ]; then
    tier=2
    interval=$MEDIUM_INTERVAL
    body="${BATTERY_LEVEL}% of battery remaining."
  fi

  last=0
  last_tier=0

  [ -f "$LOW_BATTERY_LAST" ] && last=$(cat "$LOW_BATTERY_LAST" 2>/dev/null || echo 0)
  [ -f "$LOW_BATTERY_TIER" ] && last_tier=$(cat "$LOW_BATTERY_TIER" 2>/dev/null || echo 0)

  if [ ! -f "$LOW_BATTERY_LAST" ] || [ "$tier" -gt "$last_tier" ] || [ $((now - last)) -ge "$interval" ]; then
    notify-send 'Low Battery' "$body" -u critical -i 'battery-alert' -r 9991
    echo "$now" > "$LOW_BATTERY_LAST"
    echo "$tier" > "$LOW_BATTERY_TIER"
  fi
fi
