#!/usr/bin/env bash
#
# rofi-toggles - quick menu of session/system toggles.  Bound to super + alt + t.
# Each entry shows its current state in [brackets]; picking one flips it.

set -uo pipefail
menu() { rofi -dmenu -i -no-custom -normal-window -p "Toggle"; }

st_picom()     { pgrep -x picom >/dev/null 2>&1 && echo on || echo off; }
# reflect reality (any syncthing); the toggle drives the --user unit, which is
# only meaningful once the system unit syncthing@christian is disabled
st_syncthing() { pgrep -x syncthing >/dev/null 2>&1 && echo on || echo off; }
st_pomo()      { [ -n "$("$HOME/.local/bin/pomo" status 2>/dev/null)" ] && echo on || echo off; }
# current wacom target output, remembered in ~/.cache/wacom-output (read by
# wacom-map.sh); defaults to eDP when never set
st_wacom() { local o; o="$(cat "$HOME/.cache/wacom-output" 2>/dev/null)"; echo "${o:-eDP}"; }
# pdftabs bar's on/off flag, read by watch-polytabs.sh (defaults off when unset)
st_pdftabs() { [ "$(cat /tmp/pdftabs.enabled 2>/dev/null || echo 0)" = 1 ] && echo on || echo off; }
# current wallpaper's file name, remembered by the wallpaper script
st_wallpaper() { local w; w="$(cat "$HOME/.cache/wallpaper" 2>/dev/null)"; w="${w##*/}"; echo "${w%.*}"; }

do_picom() {
	if pgrep -x picom >/dev/null 2>&1; then
		pkill -x picom
	else
		picom -b
	fi
}
do_syncthing() {
	if systemctl --user is-active --quiet syncthing.service; then
		systemctl --user stop syncthing.service
	else
		systemctl --user start syncthing.service
	fi
}
do_pomo() {
	if [ -n "$("$HOME/.local/bin/pomo" status 2>/dev/null)" ]; then
		"$HOME/.local/bin/pomo" stop
	else
		"$HOME/.local/bin/pomo" toggle
	fi
}
# cycle the wacom tablet to the next currently-connected output (eDP,
# HDMI-A-0, ...), remember it, and re-apply the mapping right away
do_wacom() {
	local state="$HOME/.cache/wacom-output" cur next i
	mapfile -t outputs < <(xrandr --query | awk '/ connected/{print $1}')
	[ "${#outputs[@]}" -eq 0 ] && return 0
	cur="$(st_wacom)"
	next="${outputs[0]}"
	for i in "${!outputs[@]}"; do
		if [ "${outputs[$i]}" = "$cur" ]; then
			next="${outputs[$(( (i + 1) % ${#outputs[@]} ))]}"
			break
		fi
	done
	echo "$next" > "$state"
	command -v notify-send >/dev/null 2>&1 && notify-send "wacom" "mapped to $next"
	setsid -f "$HOME/.local/bin/wacom-map.sh" >/dev/null 2>&1
}
do_pdftabs() { "$HOME/.local/bin/toggle-polytabs.sh"; }
# opens the wallpaper picker (rofi thumbnails); was super + alt + w
do_wallpaper() { "$HOME/.local/bin/wallpaper"; }

declare -A ACTION
opts=""
add() { opts+="$1"$'\n'; ACTION["$1"]="$2"; }

add "$(printf 'picom       [%s]' "$(st_picom)")"     do_picom
add "$(printf 'syncthing   [%s]' "$(st_syncthing)")" do_syncthing
add "$(printf 'pomodoro    [%s]' "$(st_pomo)")"      do_pomo
add "$(printf 'wacom       [%s]' "$(st_wacom)")"     do_wacom
add "$(printf 'pdftabs     [%s]' "$(st_pdftabs)")"   do_pdftabs
add "$(printf 'wallpaper   [%s]' "$(st_wallpaper)")" do_wallpaper

choice="$(printf '%s' "$opts" | menu)" || exit 0
[ -z "${choice:-}" ] && exit 0
"${ACTION[$choice]:-true}"
